# Nextflow runtime directories
.work/
work/
.nextflow*
.nxf_temp/

# nf-test runtime
.nf-test/

# Local run outputs
results*/
test_PE/test_data/
dev_full_PE/data/
samplesheets/
params/

# Large or generated assets
assets/references/
assets/annotation/
assets/*.bedgraph
assets/*.fastq
assets/*.png

# Reference genome cache (params.genome_cache, default ./.cache/genomes --
# also the Config Generator's default). Downloaded per run, multi-GB binary
# FASTA/index files -- never belongs in git. Without this, `git add .` walks
# and hashes the entire cache (can be tens of GB), which looks like a hang
# rather than the very slow, unnecessary operation it actually is.
.cache/

# Runtime-generated sentinel files (created by main.nf each run).
# Must NOT be tracked — otherwise a local run blocks `git pull` with
# "untracked working tree files would be overwritten by merge".
assets/NO_GTF
assets/EMPTY_SPIKE.fa
assets/EMPTY_SPIKE_INDEX.fa

# Conda and environments
.conda/
.env/
venv/

# Python
__pycache__/
*.py[cod]
bin/combine_reports_old.py

# Local configs and sample sheets (generated per run)
params.yaml
samplesheet.csv

# Documentation (optional / local)
CHANGELOG.md
HOW.md

# OS / editor noise
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Logs
*.log
log/
logs/

# Local batch-run queue (see scripts/batch_jobs.example.txt for the template)
scripts/batch_jobs.txt
