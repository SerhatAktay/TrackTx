// ════════════════════════════════════════════════════════════════════════════
// TrackTx Pipeline Configuration — Universal Auto-Adaptive Setup
// ════════════════════════════════════════════════════════════════════════════
//
// Automatically adapts to any environment (laptop → HPC) with smart defaults
// Resources allocated based on tool efficiency benchmarks
// No manual tuning needed!
//
// Quick Start:
//   Desktop/Mac:    -profile docker
//   Linux:          -profile conda
//   HPC:            -profile slurm,singularity
//   NFS Issues:     -profile conda_server
//   External drive: -profile docker,performance (or conda,performance)
//
// NOTE: CPU/memory helper functions live in the `params.res` map below.
//       Under the NF26 strict config parser, lib/*.groovy classes are NOT
//       visible to config closures, so they must be defined inline here.
//
// ════════════════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════════════════════════════
// MANIFEST
// ════════════════════════════════════════════════════════════════════════════

manifest {
  name            = 'tracktx'
  author          = 'Serhat Aktay <serhat.aktay@scilifelab.se>'
  description     = 'Nextflow pipeline for nascent RNA analysis (PRO-seq, GRO-seq)'
  homePage        = 'https://github.com/serhataktay/tracktx'
  version         = '1.3.0'
  mainScript      = 'main.nf'
  nextflowVersion = '>=26.04.0'
}

// ════════════════════════════════════════════════════════════════════════════
// PLUGINS
// ════════════════════════════════════════════════════════════════════════════

plugins {
  id 'nf-schema@2.1.1'
}

// ════════════════════════════════════════════════════════════════════════════
// DEFAULT PARAMETERS
// ════════════════════════════════════════════════════════════════════════════

params {
  // ──────────────────────────────────────────────────────────────────────────
  // Adaptive CPU/Memory allocation (Nextflow 26+ compatible)
  //
  // Detection logic lives INLINE here, not in lib/*.groovy: under the NF26 strict
  // config parser (ConfigDsl v2), lib classes are not visible to config closures.
  // The detection runs inside the `res = { -> ... }()` immediately-invoked
  // closure below, which yields a map of PLAIN Integers/Strings.
  //
  // NOTE: use `(expr as int)` casts, never Java-style `(int)expr` — the strict
  // parser reads `(int)(x)` as `int.call(x)` and throws MissingMethodException.
  // ──────────────────────────────────────────────────────────────────────────
  // Resources are detected ONCE at config load and stored as plain
  // Integers/Strings (not closures). This matters under NF26: most modules
  // reference `!{params...}` in their scripts, so `params` is walked when
  // computing every task's cache hash. Closures stored in params can't be
  // hashed -> floods the log with "HashBuilder - Unknown hashing type" warnings
  // and adds avoidable per-task work. Plain values hash cleanly and also avoid
  // re-running CPU/memory detection (reflection) on every task submission.
  res = { ->
    // NOTE: the strict ConfigDsl v2 parser rejects calling NAMED local closures
    // (e.g. `def f = {..}; f(x)` -> "f is not defined"), but it DOES accept
    // immediately-invoked closure literals `{ .. }(args)`. So every helper below
    // is written as an inline IIFE.
    int sysCpus = Math.max(1, { ->
      def envCpus = System.getenv('NXF_HOST_CPUS')
      envCpus ? (envCpus as Integer) : Runtime.runtime.availableProcessors()
    }())
    int sysMem = Math.max(2, { ->
      try {
        def osBean = java.lang.management.ManagementFactory.operatingSystemMXBean
        def method = osBean.class.getMethod('getTotalPhysicalMemorySize')
        long totalBytes = (method.invoke(osBean) as Long)
        return Math.max(2, ((totalBytes >> 30) as int))
      } catch (Exception _e) {
        def envMem = System.getenv('NXF_HOST_MEM')
        return envMem ? (envMem as Integer) : 8
      }
    }())

    // ── Tool-specific CPU allocation ──
    int alnC = { int t ->
      if (t <= 4)  return t
      if (t <= 8)  return 4
      if (t <= 12) return 5
      if (t <= 16) return 6
      if (t <= 32) return 6
      return 8
    }(sysCpus)
    int alnForks      = (sysCpus < 8) ? 1 : Math.max(1, ((sysCpus / alnC) as int))
    // preprocess (fastp/trim) is I/O-bound, not compute-bound: observed ~20-28%
    // of 4 cores (≈1 core busy) while the rest wait on disk. Cap at 2 so freed
    // cores raise sample-level parallelism instead of sitting idle.
    int preprocessC   = (sysCpus <= 4) ? Math.max(2, sysCpus - 1) : 2
    int tracksC       = (sysCpus <= 4) ? sysCpus : 4
    int normC         = (sysCpus <= 4) ? 2 : 4
    int divergentC    = { int t -> if (t<=4) return t; if (t<=8) return 4; if (t<=16) return 8; if (t<=32) return 8; return 8 }(sysCpus)
    int indexC        = { int t -> if (t<=4) return t; if (t<=8) return 6; if (t<=16) return 8; if (t<=32) return 12; return 16 }(sysCpus)
    int analysisC     = { int t -> if (t<=4) return 2; if (t<=8) return 2; if (t<=16) return 3; return 4 }(sysCpus)

    // ── Memory allocation (each yields a plain String like "8 GB") ──
    String lightMem = (sysMem <= 8) ? "1 GB" : ((sysMem <= 32) ? "2 GB" : "4 GB")
    String alnMem = { int g, int f ->
      if (g <= 8) return "${((g * 0.8) as int)} GB".toString()
      else if (g <= 32) { def perTask = Math.max(8, (((g * 0.6) / Math.max(1, f)) as int)); return "${Math.min(16, (perTask as int))} GB".toString() }
      else { def perTask = Math.max(12, (((g * 0.5) / Math.max(1, f)) as int)); return "${Math.min(24, (perTask as int))} GB".toString() }
    }(sysMem, alnForks)
    Closure<String> modMem = { int base, int g ->
      if (g <= 8)       return "${Math.max(2, ((g * 0.4) as int))} GB".toString()
      else if (g <= 32) return "${Math.min(((base * 1.5) as int), ((g * 0.3) as int))} GB".toString()
      else              return "${Math.min(((base * 2) as int), ((g * 0.4) as int))} GB".toString()
    }
    Closure<String> intMem = { int base, int g ->
      if (g <= 8)       return "${Math.max(4, ((g * 0.8) as int))} GB".toString()
      else if (g <= 32) return "${Math.min(((base * 2) as int), ((g * 0.5) as int))} GB".toString()
      else              return "${Math.min(((base * 3) as int), ((g * 0.6) as int))} GB".toString()
    }
    String mod3  = modMem.call(3, sysMem)
    String mod4  = modMem.call(4, sysMem)
    String mod5  = modMem.call(5, sysMem)
    String mod6  = modMem.call(6, sysMem)
    String int8  = intMem.call(8, sysMem)
    String int10 = intMem.call(10, sysMem)

    [
      systemCpus:        sysCpus,
      systemMemoryGb:    sysMem,
      lightweightCpus:   1,
      alignmentCpus:     alnC,
      alignmentForks:    alnForks,
      preprocessCpus:    preprocessC,
      tracksCpus:        tracksC,
      normCpus:          normC,
      divergentCpus:     divergentC,
      indexCpus:         indexC,
      analysisCpus:      analysisC,
      alignmentMemory:   alnMem,
      lightMemory:       lightMem,
      moderateMemory3:   mod3,
      moderateMemory4:   mod4,
      moderateMemory5:   mod5,
      moderateMemory6:   mod6,
      intensiveMemory8:  int8,
      intensiveMemory10: int10
    ]
  }()

  // Core Paths (override via params.yaml or command line)
  output_dir    = './results'
  assets_dir    = "${projectDir}/assets"
  genome_cache  = "${projectDir}/.cache/genomes"

  // Control Flags
  help          = false
  debug         = false
  verbose       = false
  force_rebuild = false
  paired_end    = false

  // Library type: controls R1 strand handling at alignment
  //   'proseq'  (default) — R1 is reverse-complemented before alignment
  //              (reads capture the 3' end of nascent RNA; standard PRO-seq/PRO-cap)
  //   'groseq'            — R1 is aligned as-is; no reverse-complement applied
  //              (reads already represent the nascent RNA strand; standard GRO-seq)
  library_type  = 'proseq'

  // Library-type-derived processing (leave null to auto-derive from library_type;
  // set explicitly to override for non-standard protocols).
  //   revcomp_r1: reverse-complement R1 before alignment.
  //     proseq → true  (R1 reads the 3' end antisense; flip onto nascent strand)
  //     groseq → false (R1 already represents the nascent strand)
  //   signal_end: which read end defines the downstream signal/divergent calling.
  //     proseq → '3p' (3' base = RNA Pol II active site, single-nt resolution)
  //     groseq → '5p' (3' end is not the Pol position; use nascent RNA 5' end)
  //   Options: '3p' | '5p'.  Pausing index counts whole-read overlap and is
  //   end-agnostic; strand handling for all downstream steps is governed by
  //   revcomp_r1 (both assays end up in nascent-strand orientation).
  revcomp_r1    = null
  signal_end    = null

  // Control condition label used by normalize_coverage_tracks (module 08) to
  // pick the reference sample for spike-in/external scaling. This default
  // ('CTRL') is a PLACEHOLDER, not a usable fallback — it will not match a
  // descriptively-named condition like "no_heat_shock" or "no_treatment".
  // You MUST override it per-run/per-dataset via the params file to your
  // actual baseline condition name (e.g. control_label: "no_heat_shock").
  // If it doesn't match anything, siCPM is disabled (factor = 0) with a
  // loud warning in the module 08 log — there is intentionally no fallback
  // that guesses a control sample (an earlier version of this pipeline did
  // that silently and produced wrong-but-plausible siCPM values). Declared
  // here so NF26 strict mode doesn't warn about an undefined parameter.
  control_label = 'CTRL'

  // Reporting
  reports_plots = 0

  // Divergent Transcription (v3.0)
  advanced = [:]

  // Feature Toggles
  fastqc_raw               = true
  counts_allow_index_build = true
  force_sort_bedgraph      = false
  preprocess_reads_lenient_cache = false  // Set true for NFS/network storage to avoid cache invalidation
  publish_mode             = 'link'       // 'copy' for external drives (exFAT/USB/NAS) - hard links fail on exFAT
  publish_trimmed_fastq    = true        // false = skip 01_trimmed_fastq (~900 MB saved per sample)
                                         //   WARNING: also disables the SRR re-run shortcut (trimmed FASTQs won't exist to check)
  publish_alignments       = true        // false = skip 02_alignments (~270 MB per sample)
  publish_sra_fastq        = true        // false = hide SRA cache under results/.sra_cache (not visible in results)
  sra_cache_dir            = null        // override: keep the (large) raw-FASTQ resume cache OFF the results drive,
                                         //   e.g. '/scratch/tracktx_sra' or a fast internal SSD. null = under results
                                         //   per publish_sra_fastq. Cache persists across runs for -resume; safe to
                                         //   delete between projects.
  publish_references_gtf   = true        // false = skip GTF file in references output (~790 MB saved)

  // Module-Specific Settings
  adapter_trimming = [:]
  barcode          = [:]
  // UMI: enabled/length/location consumed by modules 03/06 (all default-off via ?:).
  //   dedup_allmap: also UMI-deduplicate the allMap BAM in module 06 so allMap
  //   tracks match the deduped main tracks. OFF by default — umi_tools dedup is
  //   built for unique alignments and is only approximate on -k multimapper BAMs.
  umi              = [ dedup_allmap: false ]
  output           = [:]

  // Alignment / multimapping
  //   multimap_k > 1  → bowtie2 reports up to N alignments per read (-k N).
  //     • allMap BAM/tracks keep ALL reported alignments (multimappers spread
  //       across every repeat copy) — useful for spotting signal in repetitive
  //       regions where a single best position is misleading.
  //     • main BAM (-F 260, primary per read) drives counts/divergent/functional.
  //     • Because -k makes bowtie2 set MAPQ=255, deterministic NH:i tags are
  //       added after alignment and downstream "unique" filters use NH==1
  //       (see modules 11 & 13). Spike-in alignment is NOT run with -k.
  //   multimap_k <= 1 → legacy single-best mode; uniqueness uses MAPQ as before
  //       and allMap == main (no secondary alignments are produced).
  align = [
    multimap_k: 4,
    // Which mate carries the Pol II signal (3') end for paired-end coverage:
    //   'read2' (default) → flag 128 = RC(R1), matches the module-05
    //            `bowtie2 --ff -1 R2 -2 RC(R1)` layout (standard PRO-seq PE).
    //   'read1'           → flag 64; for chemistries where R1 carries the signal
    //            end. NOTE: this generally also requires a matching alignment
    //            orientation in module 05, so change it only for known protocols.
    pe_signal_mate: 'read2'
  ]

  norm = [
    emit_bw:            true,
    emit_sicpm:         true,
    emit_allmap:        true,
    emit_5p:            null,   // null = auto-detect; true = force; false = skip
    gene_end_method:   'none',  // none | tes_window | gene_body
    gene_end_window:    500,    // bp upstream of TES to sample (tes_window method)
    gene_end_min_reads: 10      // min reads to include gene in gene_body scaling
  ]

  // Replicate Merging
  replicates = [
    merge:                false,  // Merge replicates after alignment (requires concordance check)
    concordance_min:      0.9,    // Minimum Pearson/Spearman correlation to allow merge
    concordance_method:  'pearson', // pearson | spearman
    concordance_bin_size: 10000   // Genome bin size (bp) for the bedtools-multicov
                                   // correlation in 05b_check_and_merge_replicates.nf
  ]

  qc = [
    enabled:       true,   // Enable/disable FastQC
    mapq:          10,
    dedup:         true,
    depth_max_cov: 0,
    fail_map_rate_below: null,  // Fail if mapping rate < value (e.g. 50); null = disabled
    fail_strand_min: null       // Fail if either strand fraction < value (e.g. 0.30); null = disabled
  ]

  pol = [
    contrasts:        [],
    top_n:            100,
    plots:            true,
    // Pausing-index gene-body geometry
    tss_win:          50,      // TSS window ±bp
    body_offset_min:  2000,    // Min body start offset after TSS (bp)
    body_offset_frac: 0.10,    // Body start as fraction of gene length
    // Validity guard: body window must be >= this fraction of gene length,
    // else the gene is flagged truncated and reports NaN pausing index.
    // Scales with gene length so short genes don't inflate the index.
    min_body_frac:    0.10,
    min_body_len:     0,       // Optional absolute body-length floor (bp); 0 = off
    // Coverage floor for the SUMMARY/headline median pausing index in the
    // per-sample report: only genes with body_count >= this feed the median, so
    // it isn't inflated by 1-read genes on shallow/subsetted data. Per-gene
    // pausing_index.tsv is unaffected; falls back to all valid genes if <20 clear
    // the floor. 0 = disabled.
    pi_min_body_count: 10
  ]

  // Conda Environment Overrides
  conda_norm       = null
  conda_pol        = null
  conda_divergent  = null
  conda_fgr        = null
  conda_sra        = null
  conda_annotation = null

  // GTF / Annotation Options
  gtf_path = null
  gtf_url  = null
  annotation_source = 'refseq'   // refseq (UCSC), ensembl, gencode
  annotation_exclude_biotypes = ''  // e.g. rRNA,tRNA
  annotation_chr_naming = 'none'    // none, add (Ensembl->UCSC), remove (UCSC->Ensembl)

  // SRA Download: ncbi (NCBI only), ena (ENA only), auto (try NCBI, fallback to ENA)
  sra_download_source = 'auto'
  fastq_gzip          = false    // Compress downloaded FASTQs with pigz
  sra_tmp             = null     // Temp directory for fasterq-dump (null = system default)
  sra_max_size        = '200G'   // Max prefetch size for SRA downloads
}

// ════════════════════════════════════════════════════════════════════════════
// GLOBAL PROCESS DEFAULTS
// ════════════════════════════════════════════════════════════════════════════

process {
  executor  = 'local'
  scratch   = true

  cpus   = { params.res.lightweightCpus }
  memory = { params.res.moderateMemory3 }
  time   = '24h'

  errorStrategy = { task.exitStatus in [137,143] ? 'retry' : 'terminate' }
  maxRetries    = 1
  maxErrors     = -1

  beforeScript = {
    """
    mkdir -p .tmp 2>/dev/null || true
    export TMPDIR="\${PWD}/.tmp"
    export OMP_NUM_THREADS=${task.cpus}
    export OPENBLAS_NUM_THREADS=${task.cpus}
    export MKL_NUM_THREADS=${task.cpus}
    export BOWTIE2_THREADS=${task.cpus}
    export SAMTOOLS_THREADS=${task.cpus}
    export BEDTOOLS_THREADS=${task.cpus}
    """
  }

  containerOptions = {
    "--cpus=${task.cpus} --memory=${task.memory.toBytes()} --label nf-task=${task.process.replace(':', '_')}"
  }
}

// ════════════════════════════════════════════════════════════════════════════
// PROCESS-SPECIFIC RESOURCE ALLOCATION
// ════════════════════════════════════════════════════════════════════════════

process {
  // Replicate Concordance Check & Merge (bedtools + samtools)
  withName: /(?i).*check_and_merge_replicates.*/ {
    cpus     = { params.res.analysisCpus }
    memory   = { params.res.moderateMemory6 }
    time     = '4h'
    maxForks = 2
  }

  // High-Intensity Processes
  withName: /(?i).*align_reads_to_genome.*/ {
    cpus     = { params.res.alignmentCpus }
    memory   = { (params.res.alignmentMemory as nextflow.util.MemoryUnit) * task.attempt }
    time     = '8h'
    maxForks = Runtime.runtime.availableProcessors() < 8 ? 1 : Math.max(1, ((Runtime.runtime.availableProcessors() / 6) as int))
  }

  withName: /(?i).*download_genome_and_build_alignment_index.*/ {
    cpus     = { params.res.indexCpus }
    memory   = { params.res.intensiveMemory8 }
    time     = '6h'
    maxForks = 1
    // Network/IO transient failures (UCSC/NCBI) shouldn't kill the whole run on
    // the first hiccup; in-script curl retries cover most cases, this covers the rest.
    errorStrategy = { task.exitStatus in [137,143] || task.attempt <= 3 ? 'retry' : 'terminate' }
    maxRetries    = 3
  }

  withName: /(?i).*normalize_coverage_tracks.*/ {
    // Right-sized: observed peak ~160 MB (was allocated 16 GB). Attempt-scaling
    // + default 137/143 retry keep this safe while freeing memory for concurrency.
    cpus     = { params.res.normCpus }
    memory   = { (params.res.moderateMemory4 as nextflow.util.MemoryUnit) * task.attempt }
    time     = '8h'
    maxForks = Runtime.runtime.availableProcessors() < 10 ? 1 : Math.max(1, Math.min(3, ((Runtime.runtime.availableProcessors() / 8) as int)))
    scratch  = true
  }

  withName: /(?i).*detect_divergent_transcription.*/ {
    // Right-sized: old per-row code peaked ~3.4 GB; vectorized detector holds the
    // full bedGraph + prefix/feature arrays, so keep a moderate ceiling with
    // attempt-scaling and OOM retry rather than the previous flat 16 GB.
    cpus          = { params.res.divergentCpus }
    memory        = { (params.res.moderateMemory6 as nextflow.util.MemoryUnit) * task.attempt }
    time          = '8h'
    maxForks = Runtime.runtime.availableProcessors() < 12 ? 1 : Math.max(1, Math.min(3, ((Runtime.runtime.availableProcessors() / 8) as int)))
    errorStrategy = { task.exitStatus in [137,143] ? 'retry' : 'terminate' }
    maxRetries    = 2
    scratch       = true
  }

  // Cohort QC + visualization (MultiQC + deepTools). Previously fell through to
  // the 4 GB default and was OOM-killed (exit 137); deepTools multiBigwigSummary
  // scales with sample count, so give it room and let it grow on retry.
  withName: /(?i).*cohort_qc_and_viz.*/ {
    cpus          = { params.res.analysisCpus }
    memory        = { (params.res.intensiveMemory8 as nextflow.util.MemoryUnit) * task.attempt }
    time          = '4h'
    errorStrategy = { task.exitStatus in [137,143] ? 'retry' : 'terminate' }
    maxRetries    = 3
  }

  // Medium-Intensity Processes
  withName: /(?i).*preprocess_and_quality_filter_reads.*/ {
    cpus     = { params.res.preprocessCpus }
    // Observed peak RSS ~0.4 GB; moderateMemory3 (~4 GB) leaves >10x headroom and
    // keeps the heavy moderateMemory5 tier reserved for generate_coverage_tracks.
    memory   = { params.res.moderateMemory3 }
    time     = '4h'
    maxForks = Runtime.runtime.availableProcessors() < 6 ? 1 : Math.max(1, ((Runtime.runtime.availableProcessors() / 4) as int))
  }

  withName: /(?i).*generate_coverage_tracks.*/ {
    cpus     = { params.res.tracksCpus }
    memory   = { (params.res.moderateMemory5 as nextflow.util.MemoryUnit) * task.attempt }
    time     = '6h'
    maxForks = Runtime.runtime.availableProcessors() < 6 ? 1 : Math.max(1, ((Runtime.runtime.availableProcessors() / 3) as int))
  }

  withName: /(?i).*calculate_polymerase_occupancy_metrics.*/ {
    cpus     = { params.res.analysisCpus }
    // Observed peak RSS ~0.2 GB; moderateMemory3 (~4 GB) is ample and frees the
    // moderateMemory5 tier for the genuinely memory-heavy track generation.
    memory   = { params.res.moderateMemory3 }
    time     = '4h'
    maxForks = Math.max(2, ((Runtime.runtime.availableProcessors() / 3) as int))
  }

  withName: /(?i).*assign_signal_to_functional_regions.*/ {
    cpus     = { params.res.analysisCpus }
    memory   = { params.res.moderateMemory4 }
    time     = '4h'
    maxForks = Math.max(2, ((Runtime.runtime.availableProcessors() / 3) as int))
  }

  withName: /(?i)(quantify_reads_per_gene|quality_control_aligned_reads|summarize_polymerase_metrics).*/ {
    cpus     = { Math.min(2, Math.max(1, ((Runtime.runtime.availableProcessors() / 4) as int))) }
    // All three are small (observed peak RSS <0.3 GB); lightMemory is sufficient.
    memory   = { params.res.lightMemory }
    time     = '2h'
    maxForks = Math.max(4, ((Runtime.runtime.availableProcessors() / 2) as int))
  }

  // Lightweight Processes
  withName: /(?i).*download_genome_annotations.*/ {
    cpus     = { params.res.lightweightCpus }
    memory   = { params.res.lightMemory }
    time     = '4h'
    maxForks = 1
    // Retry transient network failures (UCSC/NCBI/Ensembl) instead of aborting.
    errorStrategy = { task.exitStatus in [137,143] || task.attempt <= 3 ? 'retry' : 'terminate' }
    maxRetries    = 3
  }

  withName: /(?i).*download_sra_samples.*/ {
    cpus     = { Math.min(4, Math.max(2, ((Runtime.runtime.availableProcessors() / 4) as int))) }
    memory   = { params.res.moderateMemory4 }
    time     = '6h'
    maxForks = Math.max(2, ((Runtime.runtime.availableProcessors() / 4) as int))
    // Retry transient SRA/ENA download failures instead of aborting the run.
    errorStrategy = { task.exitStatus in [137,143] || task.attempt <= 3 ? 'retry' : 'terminate' }
    maxRetries    = 3
  }

  withName: /(?i)(generate_per_sample_reports|combine_reports_into_cohort).*/ {
    cpus     = { params.res.lightweightCpus }
    memory   = { params.res.lightMemory }
    time     = '1h'
    maxForks = Math.max(4, ((Runtime.runtime.availableProcessors() / 2) as int))
  }
}

// ════════════════════════════════════════════════════════════════════════════
// EXECUTION REPORTS
// ════════════════════════════════════════════════════════════════════════════

trace {
  enabled   = true
  file      = "${params.output_dir}/trace/trace.txt"
  sep       = '\t'
  fields    = 'task_id,hash,process,tag,cpus,memory,%cpu,%mem,rss,peak_rss,vmem,peak_vmem,realtime,duration,read_bytes,write_bytes,attempt,workdir'
  overwrite = true
}

report {
  enabled   = true
  file      = "${params.output_dir}/trace/report.html"
  overwrite = true
}

timeline {
  enabled   = true
  file      = "${params.output_dir}/trace/timeline.html"
  overwrite = true
}

dag {
  enabled   = true
  file      = "${params.output_dir}/trace/flow_dag.png"
  overwrite = true
}

// ════════════════════════════════════════════════════════════════════════════
// EXECUTION PROFILES
// ════════════════════════════════════════════════════════════════════════════

profiles {
  docker {
    docker.enabled    = true
    process.container = 'ghcr.io/serhataktay/tracktx:1.3.0'
  }

  conda {
    process.executor  = 'local'
    conda.enabled     = true
    process.conda     = "${projectDir}/envs/tracktx.yaml"
    conda.useMamba        = false
    conda.cacheDir        = "${System.getenv('NXF_CONDA_CACHEDIR') ?: projectDir + '/.conda'}"
    conda.createTimeout   = '2h'
    conda.createOptions   = '--no-channel-priority --repodata-fn=repodata.json'
  }

  conda_server {
    process.executor    = 'local'
    conda.enabled       = true
    params.publish_mode = 'copy'
    process.conda       = "${System.getenv('NXF_CONDA_ENV_PATH') ?: projectDir + '/envs/tracktx.yaml'}"
    conda.useMamba        = false
    conda.useMicromamba   = false
    conda.createTimeout   = '4h'
    conda.createOptions   = '--no-channel-priority --repodata-fn=repodata.json --copy'
    conda.cacheDir        = "${System.getenv('TMPDIR') ?: '/tmp'}/nextflow-conda-${System.getProperty('user.name')}"

    process {
      stageInMode = 'copy'
      scratch     = false
    }

    beforeScript = '''
      mkdir -p .tmp 2>/dev/null || true
      export TMPDIR="${PWD}/.tmp"
      mkdir -p "${CONDA_PKGS_DIRS}" || true
      chmod 755 "${CONDA_PKGS_DIRS}" || true
      find "${CONDA_PKGS_DIRS}" -name "*.lock" -mtime +1 -delete 2>/dev/null || true
      touch "${CONDA_PKGS_DIRS}/.write_test" && rm -f "${CONDA_PKGS_DIRS}/.write_test" || {
        echo "WARNING: Cannot write to ${CONDA_PKGS_DIRS}"
        export CONDA_PKGS_DIRS="/tmp/conda-emergency-${RANDOM}"
        mkdir -p "${CONDA_PKGS_DIRS}"
      }
      _conda_init=false
      if [ -n "${CONDA_EXE}" ] && [ -x "${CONDA_EXE}" ]; then
        eval "$(${CONDA_EXE} shell.bash hook 2>/dev/null)" && _conda_init=true
      fi
      if [ "$_conda_init" = "false" ] && command -v conda >/dev/null 2>&1; then
        eval "$(conda shell.bash hook 2>/dev/null)" && _conda_init=true
      fi
      if [ "$_conda_init" = "false" ]; then
        for conda_sh in \
          "${HOME}/miniconda3/etc/profile.d/conda.sh" \
          "${HOME}/anaconda3/etc/profile.d/conda.sh" \
          "${HOME}/mambaforge/etc/profile.d/conda.sh" \
          "/opt/conda/etc/profile.d/conda.sh"
        do
          [ -f "$conda_sh" ] && source "$conda_sh" && _conda_init=true && break
        done
      fi
      if [ "$_conda_init" = "false" ]; then
        echo "ERROR: Conda initialization failed - ensure conda is installed and in PATH"
        exit 1
      fi
    '''
  }

  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    singularity.cacheDir   = "${baseDir}/.singularity"
    process.container      = 'docker://ghcr.io/serhataktay/tracktx:1.3.0'
    conda.enabled          = false
    singularity.runOptions = '--bind /tmp:/tmp --bind /var/tmp:/var/tmp --bind /scratch:/scratch --cleanenv --no-home'
  }

  apptainer {
    singularity.enabled    = true
    singularity.autoMounts = true
    singularity.cacheDir   = "${baseDir}/.singularity"
    process.container      = 'docker://ghcr.io/serhataktay/tracktx:1.3.0'
    conda.enabled          = false
    singularity.runOptions = '--bind /tmp:/tmp --bind /var/tmp:/var/tmp --bind /scratch:/scratch --cleanenv --no-home'
  }

  podman {
    podman.enabled    = true
    process.container = 'ghcr.io/serhataktay/tracktx:1.3.0'
    conda.enabled     = false
  }

  local {
    process.executor  = 'local'
    conda.enabled     = false
  }

  slurm {
    process.executor = 'slurm'
    process.queue    = 'normal'
    // process.partition  = 'normal'             // Uncomment and set for your cluster
    // process.clusterOptions = '-A project_id'  // Uncomment for cluster-specific options
  }

  // Performance optimizations for external storage (USB, NAS, network drives)
  // Use: -profile docker,performance or ./run_pipeline.sh --external-drive
  performance {
    params {
      publish_mode = 'copy'  // Hard links fail on exFAT; copy works on all filesystems
    }
    process {
      scratch  = false
      maxForks = Math.max(8, Math.min(16, ((Runtime.runtime.availableProcessors() * 1.2) as int)))

      withName: /(?i).*align_reads_to_genome.*/ {
        maxForks = Math.max(2, ((Runtime.runtime.availableProcessors() / 4) as int))
        scratch  = false
      }
      withName: /(?i).*generate_coverage_tracks.*/ {
        maxForks = Math.max(2, ((Runtime.runtime.availableProcessors() / 2) as int))
        scratch  = false
      }
      withName: /(?i).*normalize_coverage_tracks.*/ {
        maxForks = Math.max(2, Math.min(4, ((Runtime.runtime.availableProcessors() / 4) as int)))
        scratch  = false
      }
      withName: /(?i).*detect_divergent_transcription.*/ {
        maxForks = Math.max(3, ((Runtime.runtime.availableProcessors() / 2) as int))
        scratch  = false
      }
      withName: /(?i).*preprocess_and_quality_filter_reads.*/ {
        maxForks = Math.max(2, ((Runtime.runtime.availableProcessors() / 3) as int))
        scratch  = false
      }
      withName: /(?i).*calculate_polymerase_occupancy_metrics.*/ {
        maxForks = Math.max(3, ((Runtime.runtime.availableProcessors() / 2) as int))
        scratch  = false
      }
      withName: /(?i).*assign_signal_to_functional_regions.*/ {
        maxForks = Math.max(3, ((Runtime.runtime.availableProcessors() / 2) as int))
        scratch  = false
      }
      withName: /(?i)(quantify_reads_per_gene|quality_control_aligned_reads|summarize_polymerase_metrics).*/ {
        maxForks = Math.max(6, ((Runtime.runtime.availableProcessors() * 1.5) as int))
        scratch  = false
      }
      withName: /(?i).*download_(genome_annotations|sra_samples).*/ {
        maxForks = Math.max(2, ((Runtime.runtime.availableProcessors() / 3) as int))
        scratch  = false
      }
      withName: /(?i)(generate_per_sample_reports|combine_reports_into_cohort).*/ {
        maxForks = Math.max(6, ((Runtime.runtime.availableProcessors() * 1.5) as int))
        scratch  = false
      }
      withName: /(?i).*download_genome_and_build_alignment_index.*/ {
        maxForks = 1
        scratch  = false
      }
    }

    executor {
      queueSize = 200
    }

    docker {
      remove = true
    }
  }
}
